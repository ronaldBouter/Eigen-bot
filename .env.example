# Kopieer naar .env en vul in. Deel dit bestand NOOIT.
EXCHANGE=bitvavo
API_KEY=
API_SECRET=

SYMBOL=BTC/EUR
TIMEFRAME=1h

# paper = simulatie met nepgeld, live = echte orders
MODE=paper
PAPER_START_EUR=1000

# Strategie
FAST_SMA=20
SLOW_SMA=50
RSI_PERIOD=14
RSI_MAX_BUY=70

# Risicobeheer
TRADE_FRACTION=0.25     # deel van je EUR-saldo per aankoop
STOP_LOSS_PCT=0.03      # verkoop bij 3% verlies
TAKE_PROFIT_PCT=0.06    # verkoop bij 6% winst
FEE_PCT=0.0025          # geschatte handelskosten per order
